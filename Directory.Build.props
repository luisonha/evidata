<Project>
  <PropertyGroup>
    <!-- Versión semántica base. Incrementar en cada release. -->
    <VersionPrefix>1.0.0</VersionPrefix>

    <!-- SourceRevisionId se pasa desde start.sh o CI con -p:SourceRevisionId=<hash>
         El SDK de .NET lo concatena automáticamente: InformationalVersion = 1.0.0+<hash> -->

    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>

    <Company>Evidata</Company>
    <Product>Evidata Compliance Platform</Product>
    <Copyright>© 2026 Evidata</Copyright>
  </PropertyGroup>
</Project>
